# GTA VI Autonomous Media Engine: environment template.
# Copy to .env and fill in. Never commit .env. Values marked REQUIRED must be set for docker compose.
# Generate secrets:  python -c "import secrets;print(secrets.token_urlsafe(32))"
#                    python -m engine.cli gen-key   (ENGINE_ENCRYPTION_KEY)

# ----------------------------------------------------------------- core (REQUIRED)
ENGINE_ENV=production
ADMIN_API_TOKEN=                 # REQUIRED: admin bearer token (dashboard server uses it; never shipped to browsers)
VIEWER_API_TOKEN=                # optional read-only token
ENGINE_ENCRYPTION_KEY=           # REQUIRED: Fernet key encrypting OAuth tokens at rest
POSTGRES_PASSWORD=               # REQUIRED
POSTGRES_USER=engine
POSTGRES_DB=engine
DASHBOARD_USER=admin             # REQUIRED: dashboard basic-auth user
DASHBOARD_PASSWORD=              # REQUIRED: dashboard basic-auth password

# Public URLs (production overlay). OAuth redirect URIs are {PUBLIC_BASE_URL}/api/platforms/{platform}/callback
API_DOMAIN=api.example.com
DASHBOARD_DOMAIN=studio.example.com
ACME_EMAIL=ops@example.com
PUBLIC_BASE_URL=http://localhost:8000
DASHBOARD_ORIGIN=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=120

# ----------------------------------------------------------------- storage
STORAGE_BACKEND=local            # local | s3  (s3 works with AWS S3, Cloudflare R2, MinIO)
S3_ENDPOINT_URL=                 # e.g. http://minio:9000 with --profile minio, empty for AWS
S3_BUCKET=gta-media-engine
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
TEMP_RETENTION_HOURS=48
FOOTAGE_HOST_DIR=./footage       # host folder with your authorised footage (mounted read-only)
FOOTAGE_ROOTS=/footage           # container paths the rights register may import from
BACKUP_RETENTION_DAYS=14

# ----------------------------------------------------------------- AI providers
LLM_PROVIDER=offline             # anthropic | openai | offline (rule-based, source-bound scripts)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TTS_PROVIDER=placeholder         # elevenlabs | openai | placeholder (guide tone; never publishable)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
TRANSCRIPTION_PROVIDER=none      # openai | local (pip install faster-whisper) | none

# Unit prices for cost estimates. Check them against your provider's current pricing and invoices.
PRICE_LLM_INPUT_PER_MTOK=3.0
PRICE_LLM_OUTPUT_PER_MTOK=15.0
PRICE_TTS_PER_KCHAR=0.30
PRICE_TRANSCRIPTION_PER_MIN=0.006
PRICE_RENDER_PER_MIN=0.01
PRICE_SERPAPI_PER_CALL=0.015

# ----------------------------------------------------------------- research sources
YOUTUBE_API_KEY=                 # Google Cloud project with YouTube Data API v3 enabled
REDDIT_CLIENT_ID=                # reddit.com/prefs/apps, "script" or "web" app
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gta-media-engine/0.1 (by u/your_reddit_username)
REDDIT_SUBREDDITS=GTA6,GTA,rockstar
RSS_FEEDS=                       # comma separated feed URLs you are permitted to use
SERPAPI_API_KEY=                 # Google Trends signal (paid). Without it the score excludes search demand.
OFFICIAL_DOMAINS=rockstargames.com,take2games.com
OFFICIAL_YOUTUBE_CHANNEL_IDS=    # channel IDs you have verified as Rockstar's official channels
CREDIBLE_DOMAINS=ign.com,gamespot.com,polygon.com,eurogamer.net,theverge.com,bloomberg.com,reuters.com,kotaku.com,pcgamer.com,gamesindustry.biz

# ----------------------------------------------------------------- publishing apps (OAuth clients)
GOOGLE_CLIENT_ID=                # OAuth client (Web) with YouTube Data API v3 + YouTube Analytics API
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=               # TikTok for Developers app with Content Posting API (+ video.list)
TIKTOK_CLIENT_SECRET=
META_APP_ID=                     # Meta app with Instagram API with Instagram Login
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
